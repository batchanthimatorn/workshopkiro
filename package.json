{
  "name": "ai-workspace-automation",
  "version": "0.1.0",
  "description": "APP-03 — AI Workspace Automation on Google Apps Script (clasp + GAS + AI)",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "lint": "eslint src tests",
    "test": "jest",
    "test:pbt": "jest tests/properties",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test",
    "push": "npm run build && clasp push",
    "deploy": "npm run build && node scripts/deploy-and-record.mjs",
    "pull": "clasp pull"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.0",
    "@types/google-apps-script": "^1.0.83",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "esbuild": "^0.23.0",
    "eslint": "^9.9.0",
    "fast-check": "^3.19.0",
    "googleapis": "^176.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}
